; Standalone integration sandbox; never copy over PunchLine's project.godot.
config_version=5
[application]
config/name="PunchLine District Housing — integration sandbox"
run/main_scene="res://scenes/HousingPreview.tscn"
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12,0.17,0.22,1)
