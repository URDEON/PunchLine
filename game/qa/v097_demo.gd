extends RefCounted
func play(demo: SceneTree) -> void:
	var game: Node3D = demo.game
	demo.prepare(); await demo.frames(12)
	demo.say("0.9.7 · Estación 24. Acciones automatizadas; preparativos de laboratorio indicados.")
	game.preferences.set_value("camera_distance",8); await demo.frames(70); demo.shot("v097_distrito")
	demo.say("B · vidrio transparente y vista previa del emote real")
	demo.key(KEY_B); await demo.frames(45); game.interface.emote_wheel.selected = 1; await demo.frames(60)
	demo.shot("v097_rueda"); game.interface.choose_emote(1); await demo.frames(45)
	demo.verify(game.presentation.emote_time > 0,"gesto de desafío retargeteado")
	await demo.frames(160); demo.verify(game.presentation.emote_time == 0,"gesto termina y devuelve locomoción")
	demo.say("Laboratorio: colocar al jugador junto a la puerta para probar E")
	demo.prepare(); game.player.position = Vector3(26,.1,-10); game.player.reset_physics_interpolation(); await demo.frames(15)
	demo.key(KEY_E); await demo.frames(110); demo.shot("v097_puerta")
	demo.verify(game.arena.urban.gate.position.y > 5,"puerta móvil con colisión")
	demo.say("Laboratorio: colocar al jugador en el paso de vidrio. M1 real rompe el panel.")
	demo.prepare(); game.arena.urban.reset_glass(); game.player.position = Vector3(28,.1,4); game.model.rotation.y = 0; game.yaw = 0
	game.player.reset_physics_interpolation(); await demo.frames(15); game.punch(); await demo.frames(16)
	demo.shot("v097_rotura"); demo.verify(game.arena.urban.breakables[0].broken,"M1 rompe el vidrio y retira su colisión")
	demo.say("Laboratorio: jugador sobre plataforma de impulso; E activa una trayectoria física")
	demo.prepare(); game.player.position = Vector3(7,.3,22); game.player.reset_physics_interpolation(); await demo.frames(30)
	demo.key(KEY_E); await demo.frames(35); demo.shot("v097_impulso")
	demo.verify(game.player.position.y > 4,"impulso y gravedad reales")
	await demo.frames(100)
	demo.say("Laboratorio: derribo real desde la azotea · Jolt, articulaciones y rig intacto")
	game.arena.visit_zone("roof"); await demo.frames(15)
	game.player_ragdoll = true; game.player_ragdoll_time = 2.5; game.player.velocity = Vector3(1,1,0)
	await demo.frames(70); demo.shot("v097_ragdoll")
	demo.verify(game.physical_ragdoll.active and game.physical_ragdoll.skeleton.get_bone_count() == 53,"simulación conserva el esqueleto")
	await demo.frames(110)
	demo.verify(not game.player_ragdoll and game.player.position.y > 4.8,"recuperación en azotea")
	demo.say("Habilidad 1 · dos vidrios delanteros y rastro plano de la pose actual")
	demo.prepare(); await demo.frames(12)
	var enemy: Dictionary = game.enemies[0]; enemy.body.position = Vector3(0,.1,-5); game.yaw = 0
	demo.key(KEY_1); demo.verify(game.moves.gate_nodes.size() == 2,"dos fotogramas de guía")
	await demo.frames(20); demo.shot("v097_proyeccion"); await demo.frames(120)
	demo.verify(game.skill_active == "" and game.moves.gate_nodes.is_empty(),"proyección conserva ciclo y limpia guías")
	demo.prepare(); await demo.frames(15)
	demo.say("Recorrido real por la rampa urbana · Ctrl caminar y carrera")
	game.route_trial.start(); game.yaw = PI; Input.action_press("forward"); Input.action_press("walk"); await demo.frames(90)
	Input.action_release("walk"); await demo.frames(80); Input.action_release("forward"); demo.shot("v097_ruta")
	demo.verify(game.route_trial.samples.size() > 15,"eco registra movimiento y poses reales")
	game.route_trial.cancel(); game.interface.open_menu("map"); await demo.frames(80); demo.shot("v097_explorar")
	game.set_paused(false); print("DEMO RESULT %d/%d" % [demo.checks-demo.failures,demo.checks])
	game.feedback.stop_all(); OS.delay_msec(150); game.queue_free(); await demo.process_frame; await demo.process_frame
	demo.quit(1 if demo.failures else 0)
