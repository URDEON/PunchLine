extends RefCounted
func play(demo: SceneTree) -> void:
	var game: Node3D = demo.game
	demo.prepare(); await demo.frames(12)
	demo.say("0.9.6 · caminar con Ctrl, correr y salto nuevo")
	Input.action_press("walk"); Input.action_press("forward"); await demo.frames(100)
	Input.action_release("walk"); await demo.frames(60)
	demo.key(KEY_SPACE); await demo.frames(65); Input.action_release("forward")
	demo.verify(game.player.is_on_floor(),"salto real termina en aterrizaje")
	demo.prepare(); await demo.frames(12)
	demo.say("B · selector de emotes y baile sobre el rig original")
	demo.key(KEY_B); await demo.frames(60); game.interface.choose_emote(0); await demo.frames(100)
	demo.shot("v096_emote"); game.presentation.cancel_emote()
	demo.say("Kogane · órbita juguetona, comentario y retirada")
	demo.key(KEY_K); await demo.frames(90); game.presentation.comment_life = 0; game.presentation.comment("counter_miss")
	await demo.frames(80); demo.shot("v096_kogane"); demo.key(KEY_K); await demo.frames(45)
	demo.verify(not game.presentation.companion.visible,"desaparición de Kogane")
	demo.say("Azotea · ragdoll físico del jugador sin desarmar el rig")
	game.arena.visit_zone("roof"); await demo.frames(15)
	game.player_ragdoll = true; game.player_ragdoll_time = 2.0; game.player.velocity = Vector3(1,1,0)
	await demo.frames(70); demo.shot("v096_ragdoll"); await demo.frames(90)
	demo.verify(not game.player_ragdoll and game.player.position.y > 4.8,"recuperación real sobre terreno elevado")
	demo.say("Ascensor · plataforma móvil con colisión")
	game.arena.visit_zone("lift"); await demo.frames(420); demo.shot("v096_ascensor")
	demo.verify(game.player.position.y > 3,"ascensor lleva al jugador")
	demo.say("Fase 2 · vertical al parar, cabeza delante al avanzar")
	demo.prepare(); game.start_form("FORM2",true); await demo.frames(130)
	demo.shot("v096_fase2_reposo"); Input.action_press("forward"); await demo.frames(65)
	demo.shot("v096_fase2_avance"); Input.action_release("forward"); await demo.frames(80)
	demo.verify((-game.presentation.form_models[1].basis.z).dot(Vector3.UP) > .98,"fase 2 vuelve a reposo vertical")
	demo.say("Dominio · interior de 24 paneles y reloj de proyección")
	game.moves.begin_domain(); await demo.frames(120); demo.shot("v096_dominio"); game.moves.end_domain()
	demo.prepare(); await demo.frames(12)
	demo.say("Eco de ruta · registro de movimiento real por la rampa")
	game.route_trial.start(); game.yaw = PI; Input.action_press("forward"); await demo.frames(115)
	Input.action_release("forward"); demo.shot("v096_eco"); game.route_trial.cancel()
	demo.say("Menú de pausa · explorar, combate, configuración y controles")
	game.interface.open_menu("map"); await demo.frames(90); demo.shot("v096_menu")
	game.interface.select_tab("settings"); await demo.frames(60); demo.shot("v096_configuracion")
	game.set_paused(false)
	print("DEMO RESULT %d/%d" % [demo.checks-demo.failures,demo.checks])
	game.feedback.stop_all(); OS.delay_msec(150); game.queue_free(); await demo.process_frame; await demo.process_frame
	demo.quit(1 if demo.failures else 0)
