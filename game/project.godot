config_version=5
[application]
config/name="PunchLine"
config/version="0.9.29"
run/main_scene="res://ui/warfare_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
[autoload]
BuildInfo="*res://scripts/build_info.gd"
WarfareSettings="*res://core/warfare_settings.gd"
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=360
window/size/min_height=360
window/stretch/mode="disabled"
[physics]
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true
[layer_names]
3d_physics/layer_10="Escalones para apoyo de pies"
[rendering]
renderer/rendering_method="forward_plus"
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=48
environment/defaults/default_clear_color=Color(0.09,0.12,0.18,1)

anti_aliasing/quality/msaa_3d=1
